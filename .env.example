# Copia este fichero a .env. El .env nunca se commitea.

# "development" habilita /docs. Por defecto es "production", el valor seguro.
ENVIRONMENT=development

DATABASE_URL=sqlite:///./psique.db

# Obligatorio (mín. 32 caracteres). Generar uno:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_MINUTES=43200

# --- LLM ---
# "cloud" = Claude; "local" = Ollama. Sin ANTHROPIC_API_KEY el modo cloud responde en demo.
LLM_PROVIDER=cloud
ANTHROPIC_API_KEY=
LLM_CLOUD_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=2048
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=
OLLAMA_KEEP_ALIVE=10m

# Mensajes literales que ve el modelo; lo anterior va como resumen.
CONTEXT_MESSAGES=20

# --- Imágenes de perfil (avatar y banner) ---
MEDIA_DIR=./media
# Vacío = URLs relativas /media/...; el frontend debe proxyar /media como /api.
MEDIA_BASE_URL=

# --- Red ---
ALLOWED_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=60
